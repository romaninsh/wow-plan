# Copy to .env (local profile) and .env.prod (prod profile). Both stay out of git.
#
# local: the composer.yaml stack; these values work as they are.
# TARGET picks the databases the Import build / Update guides schema / Reset sample plans
# buttons act on (pipeline/import.sh, mongo/guides.sh).
TARGET=local
SECRET_WOW_URL=postgres://wow:wow@postgres:5432/wow?sslmode=disable&options=-c%20search_path%3Dwow
SECRET_PLANS_URL=mongodb://mongo:27017/wowplan?directConnection=true&serverSelectionTimeoutMS=2000
#
# prod (.env.prod), for this desktop: Cloud SQL over its public IP with TLS (this machine's
# address in the instance's authorized networks), and Atlas. Cloud Run doesn't read this file:
# its SECRET_WOW_URL (the /cloudsql socket) and SECRET_PLANS_URL are in Secret Manager.
# TARGET=prod
# WOW_PG_OWNER_URL=postgresql://wow:<password>@<public ip>:5432/wow?sslmode=require
# SECRET_WOW_URL=postgres://wow_reader:<password>@<public ip>:5432/wow?sslmode=require&options=-c%20search_path%3Dwow
# SECRET_PLANS_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wowplan?retryWrites=true&w=majority
